{
  "name": "ambient",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "demo": "tsx --env-file=demo.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "scan": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "check:mcp-contract": "tsx scripts/check-mcp-contract.ts",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:around": "tsx scripts/smoke-around.ts",
    "repro:friction": "bash scripts/repro-friction.sh",
    "latency": "tsx scripts/latency.ts",
    "infra:synth": "cdk synth",
    "infra:typecheck": "tsc -p infra/tsconfig.json --noEmit",
    "brain:latency": "tsx scripts/brain-latency.ts",
    "call:dry": "tsx scripts/call-dry.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "call": "tsx --env-file=.env src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "aws-cdk": "^2.1140.0",
    "aws-cdk-lib": "^2.114.0",
    "constructs": "^10.8.1",
    "eslint": "^10.10.0",
    "knip": "^6.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
