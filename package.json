{
  "name": "ambient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "demo": "AMBIENT_RUNTIMES_FILE=runtimes.demo.json ALLOW_UNAUTHENTICATED=true tsx src/server.ts",
    "dev:bedrock": "AMBIENT_RUNTIMES_FILE=runtimes.bedrock.json ALLOW_UNAUTHENTICATED=true tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "scan": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "check:hermes": "tsx scripts/check-hermes.ts",
    "check:hermes-contract": "tsx scripts/check-hermes-contract.ts",
    "check:mcp-contract": "tsx scripts/check-mcp-contract.ts",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "connector": "tsx scripts/connect-local.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "latency": "tsx scripts/latency.ts",
    "infra:synth": "cdk synth",
    "infra:typecheck": "tsc -p infra/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1146.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "aws-cdk": "^2.1140.0",
    "aws-cdk-lib": "^2.114.0",
    "constructs": "^10.8.1",
    "eslint": "^10.10.0",
    "knip": "^6.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
