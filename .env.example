PORT=3000
# NOTE: must match the PORT — browser calls send Origin, and the
# DNS-rebinding allowlist is seeded from this URL. Mismatched port → 403s.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Runtimes file. Default: $AMBIENT_DATA_DIR/runtimes.json
AMBIENT_RUNTIMES_FILE=
AMBIENT_DATA_DIR=.ambient
AMBIENT_RETENTION_DAYS=30
ALLOW_UNAUTHENTICATED=false
ALEXA_SKILL_ID=
# Verify Amazon request signatures on /alexa (cert chain + RSA-SHA256 + 150s
# timestamp). Required for certification — enable for any public deployment.
ALEXA_VERIFY_SIGNATURE=false
# DNS-rebinding allowlists (comma-separated). Defaults: PUBLIC_BASE_URL origin,
# plus 127.0.0.1/localhost hostnames.
AMBIENT_ALLOWED_ORIGINS=
AMBIENT_ALLOWED_HOSTS=
OAUTH_ISSUER=http://127.0.0.1:3000
OAUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
ALEXA_CLIENT_ID=ambient-alexa
ALEXA_CLIENT_SECRET=replace-with-a-long-random-secret
ALEXA_REDIRECT_URIS=
