PORT=3000
# NOTE: must match the PORT — browser calls send Origin, and the
# DNS-rebinding allowlist is seeded from this URL. Mismatched port → 403s.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Default Hermes runtime (env shorthand — equivalent to a hermes entry in runtimes.json)
HERMES_WS_URL=
HERMES_WS_TOKEN=
HERMES_RUNTIME_ID=local
HERMES_RUNTIME_KIND=local
# Optional: extra runtimes beyond the Hermes shorthand. Default: $AMBIENT_DATA_DIR/runtimes.json
AMBIENT_RUNTIMES_FILE=
AMBIENT_DATA_DIR=.ambient
AMBIENT_RETENTION_DAYS=30
ALLOW_UNAUTHENTICATED=false
CONNECTOR_TOKEN=replace-with-a-long-random-token
ALEXA_SKILL_ID=
# Verify Amazon request signatures on /alexa (cert chain + RSA-SHA256 + 150s
# timestamp). Required for certification — enable for any public deployment.
ALEXA_VERIFY_SIGNATURE=false
# DNS-rebinding allowlists (comma-separated). Defaults: PUBLIC_BASE_URL origin,
# plus 127.0.0.1/localhost hostnames.
AMBIENT_ALLOWED_ORIGINS=
AMBIENT_ALLOWED_HOSTS=
AMBIENT_BRIDGE_URL=https://your-bridge.example.com/connector
OAUTH_ISSUER=http://127.0.0.1:3000
OAUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
ALEXA_CLIENT_ID=ambient-alexa
ALEXA_CLIENT_SECRET=replace-with-a-long-random-secret
ALEXA_REDIRECT_URIS=

# --- Per-runtime adapter credentials (referenced by tokenEnv in runtimes.json) ---
# Bedrock: standard AWS credential chain (env vars, AWS_PROFILE, instance role).
AWS_REGION=us-east-1
AWS_PROFILE=

# OpenClaw: operator token for a self-hosted gateway (ws://host:18789)
OPENCLAW_TOKEN=
