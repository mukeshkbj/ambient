{
  "interactionModel": {
    "languageModel": {
      "invocationName": "ambient",
      "intents": [
        {
          "name": "StartCallIntent",
          "slots": [
            { "name": "task", "type": "AMAZON.SearchQuery" }
          ],
          "samples": [
            "call {task}",
            "find {task}",
            "handle {task}",
            "get me {task}"
          ]
        },
        {
          "name": "SteerCallIntent",
          "slots": [
            { "name": "message", "type": "AMAZON.SearchQuery" }
          ],
          "samples": [
            "tell him {message}",
            "tell her {message}",
            "tell them {message}"
          ]
        },
        {
          "name": "OfferAmountIntent",
          "slots": [
            { "name": "amount", "type": "AMAZON.NUMBER" }
          ],
          "samples": [
            "offer {amount}",
            "{amount}",
            "{amount} dollars",
            "offer {amount} dollars",
            "say {amount} dollars"
          ]
        },
        {
          "name": "CallStatusIntent",
          "samples": [
            "how's the call going",
            "how did it go",
            "how it went",
            "how it's going",
            "how is it going",
            "status",
            "what's the status",
            "any update",
            "what's happening",
            "what did they say",
            "what's up"
          ]
        },
        {
          "name": "HangUpIntent",
          "samples": [
            "hang up",
            "end the call"
          ]
        },
        {
          "name": "RetryCallIntent",
          "samples": [
            "call them again",
            "try again",
            "call again",
            "try the call again"
          ]
        },
        {
          "name": "MoveBookingIntent",
          "slots": [
            { "name": "when", "type": "AMAZON.SearchQuery" }
          ],
          "samples": [
            "move it to {when}",
            "move the booking to {when}",
            "move my booking to {when}",
            "move the plumber to {when}",
            "reschedule it for {when}",
            "reschedule to {when}",
            "change the booking to {when}"
          ]
        },
        {
          "name": "RespondApprovalIntent",
          "slots": [
            { "name": "decision", "type": "Decision" }
          ],
          "samples": [
            "{decision}",
            "{decision} it"
          ]
        },
        { "name": "AMAZON.HelpIntent", "samples": [] },
        { "name": "AMAZON.StopIntent", "samples": [] },
        { "name": "AMAZON.CancelIntent", "samples": [] },
        { "name": "AMAZON.YesIntent", "samples": [] },
        { "name": "AMAZON.NoIntent", "samples": [] },
        { "name": "AMAZON.FallbackIntent", "samples": [] }
      ],
      "types": [
        {
          "name": "Decision",
          "values": [
            { "name": { "value": "approve", "synonyms": ["allow", "yes", "once", "approve once", "book"] } },
            { "name": { "value": "deny", "synonyms": ["decline", "reject", "no", "refuse"] } }
          ]
        }
      ]
    }
  }
}
